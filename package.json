{
  "name": "glyconour",
  "version": "1.0.0",
  "description": "GlycoNour - Convertisseur de glycémie (mg/dL, g/L, mmol/L), hors connexion",
  "author": "GlycoNour",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.glyconour.app",
    "productName": "GlycoNour",
    "files": ["main.js", "index.html", "package.json"],
    "directories": { "output": "dist" },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": { "artifactName": "GlycoNour-Setup-${version}.${ext}" },
    "portable": { "artifactName": "GlycoNour-Portable-${version}.${ext}" }
  }
}
